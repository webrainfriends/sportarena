{
  "mcpServers": {
    "sportarena-http": {
      "type": "http",
      "url": "http://localhost:4000/mcp",
      "headers": { "Authorization": "Bearer sa_YOUR_API_TOKEN" }
    },
    "sportarena-stdio": {
      "command": "npm",
      "args": ["--silent", "-w", "apps/api", "run", "mcp"],
      "env": { "SPORTARENA_TOKEN": "sa_YOUR_API_TOKEN" }
    }
  }
}
