{
  "expo": {
    "name": "Gotmygame",
    "slug": "sportarena",
    "version": "0.1.0",
    "scheme": "sportarena",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF6FB",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.gotmygame.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "dev.sportarena.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EEEAF4"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Gotmygame",
      "shortName": "Gotmygame",
      "backgroundColor": "#EEEAF4",
      "themeColor": "#FF2E93",
      "favicon": "./public/favicon.png"
    },
    "extra": {
      "apiUrl": null,
      "eas": {
        "projectId": null
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos and videos of your venue to show on its page."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4F46E5"
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEEAF4"
    }
  }
}
