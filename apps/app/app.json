{
  "expo": {
    "name": "Gotmygame",
    "slug": "gotmygame",
    "version": "0.1.0",
    "scheme": ["sportarena", "com.googleusercontent.apps.909476957194-bmrrif4q7qdffemon7mrrm3puoovbg5r"],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#EEEEFF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.gotmygame.app",
      "usesAppleSignIn": true,
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true
      },
      "requireFullScreen": false
    },
    "android": {
      "package": "dev.sportarena.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#D3D3FF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Gotmygame",
      "shortName": "Gotmygame",
      "backgroundColor": "#D3D3FF",
      "themeColor": "#14123A",
      "favicon": "./public/favicon.png"
    },
    "extra": {
      "apiUrl": null,
      "eas": {
        "projectId": "0ca75a70-ab93-4649-8499-c2a64ea2c367"
      }
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos and videos of your venue to show on its page.",
          "cameraPermission": "Take photos of your venue, team or profile to share them in the app."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4A5FD9"
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#D3D3FF"
    },
    "description": "One platform for everyone who dreams of sport"
  }
}
