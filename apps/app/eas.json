{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": false,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://gotmygame.com"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk",
        "distribution": "internal"
      },
      "ios": {
        "distribution": "store"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://gotmygame.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "distribution": "internal"
      },
      "ios": {
        "distribution": "store"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://gotmygame.com"
      }
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "ascAppId": "6822294278"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6822294278"
      }
    }
  }
}
