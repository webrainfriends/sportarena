# --- SportArena API ---
DATABASE_URL=postgres://postgres@/sportarena?host=/tmp
# set DATABASE_SSL=true to require TLS to Postgres
DATABASE_SSL=false
# 32+ random bytes, base64. LOSING THIS KEY MAKES ALL ENCRYPTED DATA UNREADABLE.  openssl rand -base64 32
SPORTARENA_MASTER_KEY=
SPORTARENA_JWT_SECRET=
PORT=4000
NODE_ENV=development
# Production: terminate TLS in-process…
# SSL_KEY_FILE=/etc/tls/key.pem
# SSL_CERT_FILE=/etc/tls/cert.pem
# …or behind a TLS-terminating proxy
# TRUST_PROXY=true
CORS_ORIGINS=*

# --- Production key management (EC2 deploy sets these) ---
# KEY_PROVIDER=aws-kms        # master key wrapped by AWS KMS instead of SPORTARENA_MASTER_KEY
# KMS_KEY_ID=
# KMS_REGION=ap-southeast-1
# MASTER_KEY_FILE=/var/lib/sportarena/master.key.enc
# ALLOW_INSECURE_HTTP=false    # production only: explicitly allow plain HTTP (no TLS). Interim use only.

# --- Payments (optional; a provider is enabled when its keys are set — see docs/payments.md) ---
# PAYMENT_CURRENCY=INR            # ISO code charged by both providers (PayPal must support it for your account)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_... # endpoint: https://<host>/api/v1/webhooks/stripe  (event: checkout.session.completed)
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox              # or live
# PAYPAL_WEBHOOK_ID=              # endpoint: https://<host>/api/v1/webhooks/paypal (events: CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED)
# APP_URL=https://<host>          # optional: default return URL for checkout (otherwise the first CORS origin)

# Platform owner account (partner management). Created on first start if missing. Never commit the real password:
# on the server it comes from the PLATFORM_ADMIN_PASSWORD repo secret. Only this account can create other platform users.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_HANDLE=platformarena
PLATFORM_ADMIN_NAME=PlatformArena
# Development/tests only: set to "off" to let venues and prices go live without platform approval. Ignored in production.
# PLATFORM_APPROVALS=off
