# --- SportArena API ---
DATABASE_URL=postgres://postgres@/sportarena?host=/tmp
# set DATABASE_SSL=true to require TLS to Postgres
DATABASE_SSL=false
# 32+ random bytes, base64. LOSING THIS KEY MAKES ALL ENCRYPTED DATA UNREADABLE.  openssl rand -base64 32
SPORTARENA_MASTER_KEY=
SPORTARENA_JWT_SECRET=
PORT=4000
NODE_ENV=development
# Production: terminate TLS in-process…
# SSL_KEY_FILE=/etc/tls/key.pem
# SSL_CERT_FILE=/etc/tls/cert.pem
# …or behind a TLS-terminating proxy
# TRUST_PROXY=true
CORS_ORIGINS=*
