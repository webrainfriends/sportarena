# --- SportArena API ---
DATABASE_URL=postgres://postgres@/sportarena?host=/tmp
# set DATABASE_SSL=true to require TLS to Postgres
DATABASE_SSL=false
# 32+ random bytes, base64. LOSING THIS KEY MAKES ALL ENCRYPTED DATA UNREADABLE.  openssl rand -base64 32
SPORTARENA_MASTER_KEY=
SPORTARENA_JWT_SECRET=
PORT=4000
NODE_ENV=development
# Production: terminate TLS in-process…
# SSL_KEY_FILE=/etc/tls/key.pem
# SSL_CERT_FILE=/etc/tls/cert.pem
# …or behind a TLS-terminating proxy
# TRUST_PROXY=true
CORS_ORIGINS=*

# --- Production key management (EC2 deploy sets these) ---
# KEY_PROVIDER=aws-kms        # master key wrapped by AWS KMS instead of SPORTARENA_MASTER_KEY
# KMS_KEY_ID=
# KMS_REGION=ap-southeast-1
# MASTER_KEY_FILE=/var/lib/sportarena/master.key.enc
# ALLOW_INSECURE_HTTP=false    # production only: explicitly allow plain HTTP (no TLS). Interim use only.
